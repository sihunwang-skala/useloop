# ---- UseLoop 환경변수 (실제 값은 .env.local 에만 넣고 절대 커밋하지 마세요) ----

# "true" 이면 Supabase 없이 메모리 데모 모드로 실행됩니다.
# Supabase 값이 없으면 자동으로 데모 모드가 됩니다. 프로덕션에서는 반드시 false.
DEMO_MODE=true

# Supabase (프로덕션 모드에서 필요)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 데모 모드 세션 쿠키 서명용 비밀 값 (임의의 긴 문자열)
SESSION_SECRET=change-me-to-a-long-random-string

# 법적 검토가 끝나기 전까지 반드시 false 로 유지: 비공개 피드백 감사 혜택
FEATURE_FEEDBACK_THANKS=false

# 스폰서(광고) 노출 표시 기능. 현재 MVP 에서는 표시만 지원합니다.
FEATURE_SPONSORED_LABEL=true
